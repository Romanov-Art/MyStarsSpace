{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mystars-canva",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },

  // canva.mystars.space must be a *proxied* DNS record pointing at the
  // Dokploy origin; requests not handled here fall through to it.
  "routes": [{ "pattern": "canva.mystars.space/*", "zone_name": "mystars.space" }],

  // Secret (wrangler secret put): GIFTSCANVA_API_KEYS
  "vars": {
    "RENDER_CACHE_TTL": "86400",
    "RENDER_CACHE_VERSION": "1"
  }
}
